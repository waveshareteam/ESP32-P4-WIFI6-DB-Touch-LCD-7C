menu "UART Loopback Example Configuration"

    config EXAMPLE_UART_PORT_NUM
        int "UART port number"
        default 1

    config EXAMPLE_UART_BAUD_RATE
        int "Baud rate"
        default 115200

    config EXAMPLE_UART_RS485_ENABLE
        bool "Enable RS485 half-duplex mode"
        default y
        help
            Enable UART half-duplex RS485 mode and let the UART RTS signal
            control the transceiver direction.

endmenu
